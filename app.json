{
  "expo": {
    "name": "FamOs",
    "slug": "smart-mom-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "web": {
      "display": "standalone",
      "name": "FamOs",
      "shortName": "FamOs",
      "themeColor": "#3b5bdb",
      "backgroundColor": "#eef2fb",
      "orientation": "portrait"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "supabaseUrl": "${EXPO_PUBLIC_SUPABASE_URL}",
      "supabaseAnonKey": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}"
    }
  }
}
